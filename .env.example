# PHANI AI ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your API keys if available.
# The app works out-of-the-box with free open APIs even without paid keys!

# Gemini API Key (For Google Gemini 2.5 Flash / 1.5 Flash LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# Real-Time Service Keys (Optional - Free fallback open APIs are automatically used if empty)
WEATHER_API_KEY=
NEWS_API_KEY=
SPORTS_API_KEY=
STOCK_API_KEY=
CRYPTO_API_KEY=

# Multimedia Generation Keys (Optional - Free fallback generation is automatically used if empty)
IMAGE_API_KEY=
VIDEO_API_KEY=

# Database Connection (Default: sqlite:///phani_ai.db)
# For production PostgreSQL: postgresql://user:password@localhost:5432/phani_ai
DATABASE_URL=sqlite:///phani_ai.db
